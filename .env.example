# Get this from BotFather after /newbot - see the "how do I create my bot" walkthrough
TELEGRAM_BOT_TOKEN=

# Monad Testnet - public RPC, no key needed for reads
RPC_URL=https://testnet-rpc.monad.xyz

# URL of the deployed protean-connect wallet-linking site (see the
# protean-connect project) - powers /connect and /wallet
CONNECT_SITE_URL=http://localhost:8787

# Needed for /createdao. Get this from DeployDAOFactory.s.sol's output.
FACTORY_ADDRESS=

# Private key for the bot's operator wallet - needed for /claim,
# auto-distribution on join, and /createdao (all write actions). Bot runs
# fine in read-only mode without this set. Fund this wallet with a small
# amount of MON for gas. Never commit a real key - this is read from .env,
# which is gitignored.
OPERATOR_PRIVATE_KEY=

# Optional: your own RPC endpoint (Alchemy/QuickNode/etc) if the public one
# rate-limits you once the bot is under real load
# RPC_URL=https://your-provider-endpoint
