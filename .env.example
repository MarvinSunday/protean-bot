# Get this from BotFather after /newbot - see the "how do I create my bot" walkthrough
TELEGRAM_BOT_TOKEN=8812926435:AAGQsA8zv0TFJ1DK2j1vd77410DasjObSgE

# Monad Testnet - public RPC, no key needed for reads
RPC_URL=https://testnet-rpc.monad.xyz

# Needed for /createdao. Get this from DeployDAOFactory.s.sol's output.
FACTORY_ADDRESS=

# One factory address per other model - /createdao <name> <symbol>
# <initialSupply> <maxSupply> [model] uses whichever is set for the
# requested model. Get each from that model's own Deploy<Model>DAOFactory.s.sol
# output. A model with no address set here simply can't be created
# through /createdao yet - existing DAOs of that model can still be
# linked with /register regardless.
QUADRATIC_FACTORY_ADDRESS=
LIQUID_FACTORY_ADDRESS=
OPTIMISTIC_FACTORY_ADDRESS=
DELEGATE_FACTORY_ADDRESS=
BOARD_FACTORY_ADDRESS=
SORTITION_FACTORY_ADDRESS=
CONVICTION_FACTORY_ADDRESS=
SOWELLIAN_FACTORY_ADDRESS=
DECISION_MARKETS_FACTORY_ADDRESS=

# Private key for the bot's operator wallet - needed for /claim,
# auto-distribution on join, /createdao, and gas-funding user wallets
# (all write actions). Bot runs fine in read-only mode without this set.
# Fund this wallet with MON - it now also sponsors small gas top-ups for
# every user wallet's first transaction. Never commit a real key - this is
# read from .env, which is gitignored.
OPERATOR_PRIVATE_KEY=

# ⚠️ LEGACY. Used to deterministically derive a user's wallet from their
# Telegram ID - being replaced by KMS_KEY_ID + SUPABASE_* below. Keep this
# set for now if any existing users already have funds in derived
# wallets; new wallet creation should move to the KMS-backed system.
# Anyone who obtains this can derive and control every user's private
# key under the old system - treat it with more care than
# OPERATOR_PRIVATE_KEY. Never commit it, never log it, never share it.
MASTER_WALLET_SEED=

# KMS-backed wallet system (replaces MASTER_WALLET_SEED for new wallets).
# One symmetric key in AWS KMS, used to envelope-encrypt each user's
# independently-generated private key - see src/kmsWallet.js for the full
# design rationale. Create a symmetric KMS key in the AWS Console (KMS >
# Create key > Symmetric > Encrypt and decrypt) and paste its Key ID here.
KMS_KEY_ID=
AWS_REGION=us-east-1
# Also needs standard AWS credentials available to the process (e.g.
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or an attached IAM role if
# hosted on AWS) - the KMS SDK reads these the normal AWS SDK way, not
# through a separate variable here.

# Durable storage for KMS-backed wallet records (Supabase = managed
# Postgres). Run supabase/schema.sql once in your project's SQL editor
# before setting these. Use the service_role key, not the anon key - this
# table has Row Level Security enabled with no permissive policies, so
# only the service_role key can read or write it at all.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: your own RPC endpoint (Alchemy/QuickNode/etc) if the public one
# rate-limits you once the bot is under real load
# RPC_URL=https://your-provider-endpoint

# Opportunity Markets targets Ethereum Sepolia, not Monad - a completely
# separate network from everything else in this bot. Falls back to
# viem's public default Sepolia RPC if unset, which works for quick
# testing but will rate-limit fast under real load - same as RPC_URL
# above, just for this one feature's own network.

OPPORTUNITY_MARKET_RPC_URL=https://rpc.sepolia.org

# Needed for /createmarket - the already-deployed OpportunityMarketFactory
# on Sepolia. Without this, /createmarket is unavailable, but
# /registermarket still works for linking an already-deployed market.
# OPPORTUNITY_MARKET_FACTORY_ADDRESS=0xYourFactoryAddress
